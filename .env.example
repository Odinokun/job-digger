# Шаблон змінних середовища. Скопіюй у .env і підставь свої значення:
#   cp .env.example .env
#
# .env у git не потрапляє, .env.example - потрапляє. Тому справжніх паролів і
# ключів у цьому файлі бути не може, лише placeholder'и.
#
# Файл читають і Next.js, і Docker Compose, і drizzle-kit, тому він один на всіх.

# --- Локальна база даних PostgreSQL у Docker -------------------------------

# Користувач (створюється суперюзером), база і пароль виникають при першій
# ініціалізації контейнера. Змінити їх згодом можна лише через
# `docker compose down -v`, тобто з видаленням усіх локальних даних.
# Назви: лише латиниця в нижньому регістрі, цифри й підкреслення.
POSTGRES_USER=job_digger
POSTGRES_DB=job_digger

# Пароль не має містити @ : / ? - це службові символи в DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME

# Порт на хості. Змінюй лише якщо 5432 уже зайнятий іншим PostgreSQL.
POSTGRES_PORT=5432

# Адреса бази для застосунку й міграцій. Користувач, пароль, порт і назва бази
# мають збігатися зі значеннями вище. На Vercel тут буде Neon.
DATABASE_URL=postgres://job_digger:CHANGE_ME@127.0.0.1:5432/job_digger

# Окрема база для інтеграційних тестів у тому самому контейнері: тести чистять
# таблиці перед кожним тестом, тому в базу розробки їм ходити не можна.
# Створюється автоматично при першому запуску `npm run test:integration`.
TEST_DATABASE_URL=postgres://job_digger:CHANGE_ME@127.0.0.1:5432/job_digger_test

# Окрема база для E2E-тестів у тому самому контейнері: сценарії додають і
# видаляють компанії, а перед кожним прогоном база чиститься. Playwright передає
# її застосунку як DATABASE_URL. Створюється автоматично при першому
# `npm run test:e2e`. Має відрізнятися і від DATABASE_URL, і від TEST_DATABASE_URL.
E2E_DATABASE_URL=postgres://job_digger:CHANGE_ME@127.0.0.1:5432/job_digger_e2e

# Тека для резервних копій бази з DATABASE_URL (`npm run db:backup`, а також
# `npm run app` раз на добу і `npm run app:update` перед міграціями). Потрібна
# лише в робочому екземплярі; у теці розробки лишай порожньою - копій не буде.
# Абсолютний шлях до наявної теки, `~` не розгортається; шлях із пробілами
# краще взяти в лапки. Тримаються 30 останніх копій.
BACKUP_DIR=

# --- Зовнішні запити ---------------------------------------------------------

# Адреса фейкового вебсервера: з нею всі зовнішні запити застосунку йдуть на нього
# замість справжніх сайтів. Задають лише тести - Playwright передає її застосунку
# сам. Для звичайної роботи лишай порожньою. Дозволено лише цю машину
# (127.0.0.1, ::1, localhost) - інше значення зупинить застосунок.
FAKE_WEB_ORIGIN=

# Скільки вакансій щонайбільше читати з одного джерела (Vacancies to check).
# Стосується лише джерел, що віддають список сторінками; сторінки рахуються з
# розміру сторінки платформи: PeopleForce по 10, Workday по 20, Lever і Hurma
# по 100. Досягнення ліміту - нормальне завершення перевірки, а вакансії за ним
# не вважаються зниклими. Ціле число від 1 до 1000; порожньо - 500.
VACANCIES_TO_CHECK=

# Скільки повторів після збою мережі, тайм-ауту чи помилки сервера (5xx), з
# паузою, що зростає (1 с, потім 2 с). На 4xx, зокрема 404, повторів немає.
# Ціле число від 0 до 2; порожньо - 2.
RETRY_ATTEMPTS=

# --- Черга перевірок ---------------------------------------------------------

# Скільки карʼєрних джерел перевіряється одночасно (Parallel source checks).
# Ліміт спільний для всіх користувачів і всіх процесів сервера.
# Ціле число від 1 до 10; порожньо - 5.
PARALLEL_SOURCE_CHECKS=

# Автоматичні перевірки за розкладом (інтервал - у Settings) і перевірка на
# старті, якщо остання загальна була понад годину тому. `off` вимикає обидві,
# наприклад на час розробки; ручні перевірки працюють. Порожньо або `on` -
# увімкнено. Інше значення зупинить застосунок.
AUTO_CHECK=
