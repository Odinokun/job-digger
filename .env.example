# Environment variable template. Copy it to .env and fill in your own values:
#   cp .env.example .env
#
# .env never reaches git, .env.example does. That is why this file can hold no real
# passwords or keys, only placeholders.
#
# Next.js, Docker Compose and drizzle-kit all read this file, so there is one for all.

# --- Local PostgreSQL database in Docker -------------------------------------

# The user (created as a superuser), the database and the password come into being on
# the container's first initialisation. They can be changed later only with
# `docker compose down -v`, that is by deleting all local data.
# Names: lower-case Latin letters, digits and underscores only.
POSTGRES_USER=job_digger
POSTGRES_DB=job_digger

# The password must not contain @ : / ? - these are special characters in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME

# The port on the host. Change it only if 5432 is already taken by another PostgreSQL.
POSTGRES_PORT=5432

# The database address for the app and migrations. The user, password, port and
# database name must match the values above. On Vercel this will be Neon.
DATABASE_URL=postgres://job_digger:CHANGE_ME@127.0.0.1:5432/job_digger

# A separate database for integration tests in the same container: the tests clear
# the tables before every test, so they must not touch the development database.
# Created automatically on the first `npm run test:integration`.
TEST_DATABASE_URL=postgres://job_digger:CHANGE_ME@127.0.0.1:5432/job_digger_test

# A separate database for E2E tests in the same container: the scenarios add and
# delete companies, and the database is cleared before every run. Playwright passes
# it to the app as DATABASE_URL. Created automatically on the first
# `npm run test:e2e`. Must differ from both DATABASE_URL and TEST_DATABASE_URL.
E2E_DATABASE_URL=postgres://job_digger:CHANGE_ME@127.0.0.1:5432/job_digger_e2e

# The folder for backups of the DATABASE_URL database (`npm run db:backup`, as well as
# `npm run app` once a day and `npm run app:update` before migrations). Needed only
# in the working instance; leave it empty in the development folder - there will be
# no backups. An absolute path to an existing folder, `~` is not expanded; a path with
# spaces is better quoted. The 30 latest backups are kept.
BACKUP_DIR=

# --- Outgoing requests -------------------------------------------------------

# The fake web server address: with it, all of the app's outgoing requests go to it
# instead of real sites. Only tests set it - Playwright passes it to the app itself.
# Leave it empty for normal work. Only this machine is allowed
# (127.0.0.1, ::1, localhost) - any other value stops the app.
FAKE_WEB_ORIGIN=

# The most vacancies to read from one source (Vacancies to check).
# Applies only to sources that return the list in pages; the page count follows the
# platform's page size: PeopleForce 10, Workday 20, Lever and Hurma 100. Reaching the
# limit is a normal end of the check, and vacancies beyond it are not considered
# gone. An integer from 1 to 1000; empty means 500.
VACANCIES_TO_CHECK=

# How many retries after a network failure, a timeout or a server error (5xx), with a
# growing pause (1 s, then 2 s). There are no retries on 4xx, 404 included.
# An integer from 0 to 2; empty means 2.
RETRY_ATTEMPTS=

# --- Check queue -------------------------------------------------------------

# How many career sources are checked at once (Parallel source checks).
# The limit is shared by all users and all server processes.
# An integer from 1 to 10; empty means 5.
PARALLEL_SOURCE_CHECKS=

# Scheduled automatic checks (the interval is in Settings) and a check on start if
# the last general one was over an hour ago. `off` turns both off, for example during
# development; manual checks keep working. Empty or `on` means on. Any other value
# stops the app.
AUTO_CHECK=
