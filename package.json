{
  "name": "job-digger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "app": "node --env-file=.env src/server/db/backup.ts --if-due && next start -H 127.0.0.1 -p 3100",
    "app:update": "test \"$(git branch --show-current)\" = main || { echo 'app:update runs only on main' >&2; exit 1; }; git pull --ff-only && npm ci && npm run db:backup && npm run db:migrate && npm run build",
    "app:restart": "node src/server/autostart/autostart.ts restart",
    "autostart:on": "node src/server/autostart/autostart.ts on",
    "autostart:off": "node src/server/autostart/autostart.ts off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env src/server/db/seed.ts",
    "db:seed:demo": "node --env-file=.env src/server/db/seed-demo.ts",
    "db:backup": "node --env-file=.env src/server/db/backup.ts",
    "db:check": "node --env-file=.env src/server/db/check-connection.ts",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:pending": "playwright test --project=pending",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.23.1",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.22": true,
    "fsevents@2.3.3": true
  }
}
