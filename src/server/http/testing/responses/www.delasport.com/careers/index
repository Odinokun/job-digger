<script type="text/javascript" id="ct_code_block_js_1281">// Function to handle department card clicks
function handleDepartmentCardClick(event) {
  // Prevent the default link behavior of the button
    event.preventDefault();

  const departmentName = event.currentTarget.getAttribute('data-department');
    
    // Get the message container element
    const messageContainer = document.getElementById('no-jobs-message');

    if (departmentName) {
        // Find the department filter dropdown and update its value
        const departmentFilter = document.getElementById('department-filter');
        if (departmentFilter) {
            // Check if the department name exists in the dropdown options
            let departmentExists = false;
            for (let i = 0; i < departmentFilter.options.length; i++) {
                if (departmentFilter.options[i].value === departmentName) {
                    departmentExists = true;
                    break;
                }
            }
            
            if (departmentExists) {
                departmentFilter.value = departmentName;
                // Hide any previous message
                if (messageContainer) {
                    messageContainer.style.display = 'none';
                }
            } else {
                departmentFilter.value = ""; // Reset to "All Departments"
                // Display the new on-page message
                if (messageContainer) {
                    messageContainer.textContent = `There are no current openings in the "${departmentName}" department. Take a look at all of our open roles.`;
                    messageContainer.style.display = 'block';

                    // Automatically hide the message after 3 seconds
                    setTimeout(() => {
                        messageContainer.style.display = 'none';
                    }, 5000);
                }
            }

            // Trigger a change event to activate the existing filtering logic
            const changeEvent = new Event('change');
            departmentFilter.dispatchEvent(changeEvent);
        }

        //Scroll smoothly to the main job board container
        const jobBoardContainer = document.querySelector('.greenhouse-job-board');
        if (jobBoardContainer) {
            jobBoardContainer.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
    }
}

// Add click listeners to all department card buttons
document.addEventListener('DOMContentLoaded', () => {
    const departmentCards = document.querySelectorAll('[data-department]');
    departmentCards.forEach(card => {
        card.addEventListener('click', handleDepartmentCardClick);
    });
});
</script>
<script type="text/javascript" id="ct_code_block_js_1393"> class ScrollDragHandler {
            constructor(scrollArea) {
                this.scrollArea = scrollArea;
                this.isDragging = false;
                this.startPosition = 0;
                this.initialScroll = 0;
                this.dragVelocity = 0;
                this.inertia = 0;
                this.previousPosition = 0;
                this.animationId = null;
                
                this.setupEvents();
            }
            
            setupEvents() {
                // Mouse interaction events
                this.scrollArea.addEventListener('mousedown', this.onDragStart.bind(this));
                this.scrollArea.addEventListener('mouseleave', this.onDragEnd.bind(this));
                this.scrollArea.addEventListener('mouseup', this.onDragEnd.bind(this));
                this.scrollArea.addEventListener('mousemove', this.onDragMove.bind(this));
                
                // Touch interaction events
                this.scrollArea.addEventListener('touchstart', this.onTouchStart.bind(this), { passive: false });
                this.scrollArea.addEventListener('touchend', this.onTouchEnd.bind(this));
                this.scrollArea.addEventListener('touchmove', this.onTouchMove.bind(this), { passive: false });
                
                // Prevent image dragging
                this.scrollArea.addEventListener('dragstart', e => e.preventDefault());
                
                // Wheel scrolling enhancement
                this.scrollArea.addEventListener('wheel', this.onWheelScroll.bind(this), { passive: false });
            }
            
            onDragStart(e) {
              // Don't start dragging if clicking on a button or link
    if (e.target.closest('.career-link-btn')) {
        return;
    }
                this.isDragging = true;
                this.scrollArea.classList.add('scroll-active');
                this.startPosition = e.pageX - this.scrollArea.offsetLeft;
                this.initialScroll = this.scrollArea.scrollLeft;
                this.dragVelocity = 0;
                this.previousPosition = e.pageX;
                
                if (this.animationId) {
                    cancelAnimationFrame(this.animationId);
                }
            }
            
            onDragEnd() {
                this.isDragging = false;
                this.scrollArea.classList.remove('scroll-active');
                this.startInertiaScroll();
            }
            
            onDragMove(e) {
                if (!this.isDragging) return;
                
                e.preventDefault();
                const currentX = e.pageX - this.scrollArea.offsetLeft;
                const dragDistance = (currentX - this.startPosition) * 2;
                
                this.dragVelocity = e.pageX - this.previousPosition;
                this.previousPosition = e.pageX;
                
                this.scrollArea.scrollLeft = this.initialScroll - dragDistance;
            }
            
            onTouchStart(e) {
                const touch = e.touches[0];
                this.isDragging = true;
                this.scrollArea.classList.add('scroll-active');
                this.startPosition = touch.pageX - this.scrollArea.offsetLeft;
                this.initialScroll = this.scrollArea.scrollLeft;
                this.dragVelocity = 0;
                this.previousPosition = touch.pageX;
                
                if (this.animationId) {
                    cancelAnimationFrame(this.animationId);
                }
            }
            
            onTouchEnd() {
                this.isDragging = false;
                this.scrollArea.classList.remove('scroll-active');
                this.startInertiaScroll();
            }
            
            onTouchMove(e) {
                if (!this.isDragging) return;
                
                e.preventDefault();
                const touch = e.touches[0];
                const currentX = touch.pageX - this.scrollArea.offsetLeft;
                const dragDistance = (currentX - this.startPosition) * 2;
                
                this.dragVelocity = touch.pageX - this.previousPosition;
                this.previousPosition = touch.pageX;
                
                this.scrollArea.scrollLeft = this.initialScroll - dragDistance;
            }
            
            onWheelScroll(e) {
                const hasHorizontalScroll = this.scrollArea.scrollWidth > this.scrollArea.clientWidth;
    const isHorizontalIntent = e.shiftKey || Math.abs(e.deltaX) > Math.abs(e.deltaY);
    
    if (hasHorizontalScroll && isHorizontalIntent) {
        e.preventDefault();
        const scrollDelta = e.deltaY || e.deltaX;
        this.scrollArea.scrollLeft += scrollDelta;
    }
            }
            
            startInertiaScroll() {
                if (Math.abs(this.dragVelocity) > 1) {
                    this.inertia = this.dragVelocity * 0.95;
                    this.animateInertia();
                }
            }
            
            animateInertia() {
                if (Math.abs(this.inertia) < 0.5) {
                    return;
                }
                
                this.scrollArea.scrollLeft -= this.inertia;
                this.inertia *= 0.95;
                
                this.animationId = requestAnimationFrame(() => this.animateInertia());
            }
        }
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
            const scrollAreas = document.querySelectorAll('[data-scroll-container]');
            scrollAreas.forEach(area => {
                new ScrollDragHandler(area);
            });
        });
        
        // Button interaction handling
        document.querySelectorAll('.career-link-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const viewAll = document.querySelector(".show-more-btn");
                viewAll.style.display = "none";
                const deptName = btn.getAttribute('data-dept-name');
                console.log(`Career exploration for: ${deptName}`);
                
                btn.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    btn.style.transform = '';
                }, 150);
            });
        });</script>
